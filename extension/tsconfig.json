{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src", "tests", "vite.config.ts", "manifest.config.ts", "../plugin/venchrome/protocol.ts", "../plugin/tests"]
}
